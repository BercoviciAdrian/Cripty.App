<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cripty.ViewModels"
             xmlns:views="using:Cripty.Views"
             x:Class="Cripty.Views.MainVaultView"
             x:DataType="vm:MainVaultViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ControlTheme x:Key="StretchingItemContainerTheme"
                      TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.sidebar-action">
            <Setter Property="Padding"
                    Value="9,6" />
            <Setter Property="FontSize"
                    Value="9" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>

        <Style Selector="Button.folder-toggle">
            <Setter Property="Width"
                    Value="18" />
            <Setter Property="Height"
                    Value="24" />
            <Setter Property="MinWidth"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
        </Style>

        <Style Selector="Button.folder-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="Transparent" />
        </Style>

        <Style Selector="Button.folder-toggle:pointerover">
            <Setter Property="Background"
                    Value="#173322" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrightBrush}" />
        </Style>

        <Style Selector="Button.folder-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#173322" />
        </Style>

        <Style Selector="ComboBox.entry-sort">
            <Setter Property="Background"
                    Value="#09150F" />
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyTextBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="3" />
            <Setter Property="Padding"
                    Value="11,9" />
        </Style>

        <Style Selector="ComboBox.entry-sort:pointerover">
            <Setter Property="Background"
                    Value="{StaticResource CriptySurfaceRaisedBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrightBrush}" />
        </Style>

        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background"
                    Value="#173322" />
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyTextBrush}" />
        </Style>

        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyTextBrush}" />
        </Style>

        <Style Selector="Button.vault-nav">
            <Setter Property="Margin"
                    Value="0,0,0,3" />
            <Setter Property="Padding"
                    Value="10,8" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style Selector="Button.vault-nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style Selector="Button.vault-nav:pointerover">
            <Setter Property="Background"
                    Value="#13291C" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrush}" />
        </Style>

        <Style Selector="Button.vault-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#13291C" />
        </Style>

        <Style Selector="Button.vault-nav.selected">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrightBrush}" />
        </Style>

        <Style Selector="Button.vault-nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
        </Style>

        <Style Selector="Button.vault-nav.selected:pointerover">
            <Setter Property="Background"
                    Value="#214E32" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.vault-nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#214E32" />
        </Style>

        <Style Selector="Button.vault-nav.copy-selected">
            <Setter Property="Background"
                    Value="#173D27" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.vault-nav.copy-selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#173D27" />
        </Style>

        <Style Selector="Button.folder-entry">
            <Setter Property="Margin"
                    Value="0,0,0,2" />
            <Setter Property="Padding"
                    Value="10,6" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style Selector="Button.folder-entry /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style Selector="Button.folder-entry:pointerover">
            <Setter Property="Background"
                    Value="#13291C" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrush}" />
        </Style>

        <Style Selector="Button.folder-entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#13291C" />
        </Style>

        <Style Selector="Button.folder-entry.selected">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.folder-entry.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
        </Style>

        <Style Selector="Button.folder-entry.new-entry">
            <Setter Property="Background"
                    Value="#0D2A19" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.folder-entry.new-entry /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#0D2A19" />
        </Style>

        <Style Selector="Button.folder-entry.modified-entry">
            <Setter Property="Background"
                    Value="#0B2030" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyInfoBrush}" />
        </Style>

        <Style Selector="Button.folder-entry.modified-entry /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#0B2030" />
        </Style>

        <Style Selector="Button.folder-entry.pending-deletion">
            <Setter Property="Background"
                    Value="#291B13" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.folder-entry.pending-deletion /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#291B13" />
        </Style>

        <Style Selector="Button.folder-entry.copy-selected">
            <Setter Property="Background"
                    Value="#173D27" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.folder-entry.copy-selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#173D27" />
        </Style>

        <Style Selector="Button.entry-row">
            <Setter Property="Margin"
                    Value="0,0,0,9" />
            <Setter Property="Padding"
                    Value="16,14" />
            <Setter Property="Background"
                    Value="{StaticResource CriptySurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrush}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style Selector="Button.entry-row /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{StaticResource CriptySurfaceBrush}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style Selector="Button.entry-row:pointerover">
            <Setter Property="Background"
                    Value="{StaticResource CriptySurfaceRaisedBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyBorderBrightBrush}" />
        </Style>

        <Style Selector="Button.entry-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{StaticResource CriptySurfaceRaisedBrush}" />
        </Style>

        <Style Selector="Button.entry-row.selected">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.entry-row.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="{StaticResource CriptyAccentDarkBrush}" />
        </Style>

        <Style Selector="Button.entry-row.selected:pointerover">
            <Setter Property="Background"
                    Value="#214E32" />
        </Style>

        <Style Selector="Button.entry-row.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#214E32" />
        </Style>

        <Style Selector="Button.entry-row.new-entry">
            <Setter Property="Background"
                    Value="#0D2A19" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.entry-row.new-entry /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#0D2A19" />
        </Style>

        <Style Selector="Button.entry-row.new-entry:pointerover">
            <Setter Property="Background"
                    Value="#164627" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.entry-row.new-entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#164627" />
        </Style>

        <Style Selector="Button.entry-row.new-entry.selected">
            <Setter Property="Background"
                    Value="#164627" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.entry-row.new-entry.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#164627" />
        </Style>

        <Style Selector="Button.entry-row.modified-entry">
            <Setter Property="Background"
                    Value="#0B2030" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyInfoBrush}" />
        </Style>

        <Style Selector="Button.entry-row.modified-entry /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#0B2030" />
        </Style>

        <Style Selector="Button.entry-row.modified-entry:pointerover">
            <Setter Property="Background"
                    Value="#12344A" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyInfoBrush}" />
        </Style>

        <Style Selector="Button.entry-row.modified-entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#12344A" />
        </Style>

        <Style Selector="Button.entry-row.modified-entry.selected">
            <Setter Property="Background"
                    Value="#12344A" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyInfoBrush}" />
        </Style>

        <Style Selector="Button.entry-row.modified-entry.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#12344A" />
        </Style>

        <Style Selector="Button.entry-row.pending-deletion">
            <Setter Property="Background"
                    Value="#291B13" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.entry-row.pending-deletion /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#291B13" />
        </Style>

        <Style Selector="Button.entry-row.pending-deletion:pointerover">
            <Setter Property="Background"
                    Value="#48271A" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.entry-row.pending-deletion:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#48271A" />
        </Style>

        <Style Selector="Button.entry-row.pending-deletion.selected">
            <Setter Property="Background"
                    Value="#48271A" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.entry-row.pending-deletion.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#48271A" />
        </Style>

        <Style Selector="Button.entry-row.copy-selected">
            <Setter Property="Background"
                    Value="#173D27" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyAccentBrush}" />
        </Style>

        <Style Selector="Button.entry-row.copy-selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#173D27" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background"
                    Value="#291B13" />
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyDangerBrush}" />
            <Setter Property="BorderBrush"
                    Value="#6B4632" />
        </Style>

        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#291B13" />
            <Setter Property="Foreground"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background"
                    Value="#48271A" />
            <Setter Property="Foreground"
                    Value="#FFC0A5" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource CriptyDangerBrush}" />
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#48271A" />
            <Setter Property="Foreground"
                    Value="#FFC0A5" />
        </Style>

        <Style Selector="Button.danger:pressed">
            <Setter Property="Background"
                    Value="#6B3522" />
            <Setter Property="Foreground"
                    Value="#FFE0D2" />
        </Style>

        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background"
                    Value="#6B3522" />
            <Setter Property="Foreground"
                    Value="#FFE0D2" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource CriptyBackgroundBrush}"
          RowDefinitions="Auto,*"
          MinHeight="0"
          ClipToBounds="True">

        <!-- Vault toolbar -->
        <Border Grid.Row="0"
                Padding="32,18"
                BorderBrush="{StaticResource CriptyBorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="CRIPTY"
                               FontSize="22"
                               FontWeight="Bold"
                               LetterSpacing="4"
                               Foreground="{StaticResource CriptyAccentBrush}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="7">
                        <TextBlock Text="OPEN VAULT:"
                                   FontSize="10"
                                   LetterSpacing="1.5"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBlock Text="{Binding VaultName}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.2"
                                   Foreground="{StaticResource CriptyTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="16,0"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Background="#0A1C12"
                        BorderBrush="{StaticResource CriptyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">

                    <TextBlock Text="{Binding SaveStatusText}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               LetterSpacing="1"
                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                </Border>

                <Button Grid.Column="2"
                        Classes="primary"
                        Command="{Binding SaveCommand}"
                        MinWidth="98"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding SaveActionText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.2" />
                </Button>

                <Button Grid.Column="3"
                        Classes="ghost"
                        Command="{Binding RequestLockVaultCommand}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">

                    <TextBlock Text="LOCK VAULT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.1" />
                </Button>

                <Button Grid.Column="4"
                        Classes="ghost"
                        Command="{Binding MoreOptionsCommand}"
                        VerticalAlignment="Center">

                    <TextBlock Text="MORE OPTIONS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.1" />
                </Button>
            </Grid>
        </Border>

        <!-- Browser -->
        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              MinHeight="0"
              ClipToBounds="True">

            <Border Grid.Row="0"
                    IsVisible="{Binding HasError}"
                    Margin="20,16,20,0"
                    Padding="12"
                    Background="#291B13"
                    BorderBrush="{StaticResource CriptyDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="3">

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource CriptyDangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="300,*"
                  MinHeight="0"
                  ClipToBounds="True">

                <!-- Folder and tag navigation -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource CriptyBorderBrush}"
                        BorderThickness="0,0,1,0">

                    <Grid RowDefinitions="*,*"
                          MinHeight="0"
                          ClipToBounds="True">

                        <!-- Folders -->
                        <Grid Grid.Row="0"
                              RowDefinitions="Auto,*"
                              MinHeight="0"
                              ClipToBounds="True">

                            <Border Grid.Row="0"
                                    Padding="18,15"
                                    BorderBrush="{StaticResource CriptyBorderBrush}"
                                    BorderThickness="0,0,0,1">

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Text="FOLDERS"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <Button Grid.Column="1"
                                            Classes="sidebar-action"
                                            Command="{Binding NewFolderCommand}"
                                            Margin="0,0,6,0">

                                        <TextBlock Text="NEW"
                                                   LetterSpacing="1" />
                                    </Button>

                                    <Button Grid.Column="2"
                                            Classes="sidebar-action"
                                            Command="{Binding OpenFolderMoveCommand}"
                                            Margin="0,0,6,0">

                                        <TextBlock Text="MOVE"
                                                   LetterSpacing="1" />
                                    </Button>

                                    <Button Grid.Column="3"
                                            Classes="sidebar-action danger"
                                            Command="{Binding DeleteFolderCommand}">

                                        <TextBlock Text="DELETE"
                                                   LetterSpacing="1" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          MinHeight="0"
                                          VerticalAlignment="Stretch"
                                          AllowAutoHide="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Visible">

                                <ItemsControl ItemsSource="{Binding FolderItems}"
                                              Margin="10"
                                              HorizontalAlignment="Stretch"
                                              ItemContainerTheme="{StaticResource StretchingItemContainerTheme}">

                                    <ItemsControl.DataTemplates>
                                        <DataTemplate DataType="{x:Type vm:VaultFolderListItemViewModel}"
                                                      x:DataType="vm:VaultFolderListItemViewModel">
                                            <Grid>
                                                <Button Classes="vault-nav"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Classes.copy-selected="{Binding IsCopySelected}"
                                                        Command="{Binding SelectCommand}">

                                                    <Button.ContextMenu>
                                                        <ContextMenu IsEnabled="{Binding CanCreateInFolder}">
                                                            <MenuItem Header="NEW ENTRY"
                                                                      Command="{Binding NewEntryCommand}" />

                                                            <MenuItem Header="NEW FOLDER"
                                                                      Command="{Binding NewFolderCommand}" />

                                                            <Separator />

                                                            <MenuItem Header="RENAME"
                                                                      Command="{Binding RenameCommand}" />

                                                            <MenuItem Header="MOVE"
                                                                      Command="{Binding MoveCommand}" />

                                                            <MenuItem Header="DELETE"
                                                                      Command="{Binding DeleteCommand}"
                                                                      Foreground="{StaticResource CriptyDangerBrush}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>

                                                    <Grid ColumnDefinitions="Auto,18,Auto,*,Auto">
                                                        <Border Width="{Binding IndentWidth}" />

                                                        <Border Grid.Column="2"
                                                                Width="22"
                                                                IsVisible="{Binding IsCopySelectionMode}" />

                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding EntryCountText}"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="8"
                                                                   LetterSpacing="0.7"
                                                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                                                    </Grid>
                                                </Button>

                                                <Grid ColumnDefinitions="Auto,18,Auto,*">
                                                    <Border Width="{Binding IndentWidth}" />

                                                    <Button Grid.Column="1"
                                                            Classes="folder-toggle"
                                                            IsVisible="{Binding IsExpandable}"
                                                            Command="{Binding ToggleExpansionCommand}"
                                                            ToolTip.Tip="Expand or collapse folder">

                                                        <TextBlock Text="{Binding ExpansionGlyph}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource CriptyAccentBrush}" />
                                                    </Button>

                                                    <CheckBox Grid.Column="2"
                                                              IsVisible="{Binding CanCopySelect}"
                                                              IsChecked="{Binding IsCopySelected, Mode=OneWay}"
                                                              Command="{Binding ToggleCopySelectionCommand}"
                                                              Margin="0,0,7,0"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type vm:VaultFolderEntryListItemViewModel}"
                                                      x:DataType="vm:VaultFolderEntryListItemViewModel">
                                            <Button Classes="folder-entry"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Classes.copy-selected="{Binding IsCopySelected}"
                                                    Classes.new-entry="{Binding IsNewEntry}"
                                                    Classes.modified-entry="{Binding IsModifiedEntry}"
                                                    Classes.pending-deletion="{Binding IsPendingDeletion}"
                                                    Command="{Binding SelectCommand}"
                                                    ToolTip.Tip="Show entry">

                                                <Button.ContextMenu>
                                                    <ContextMenu IsEnabled="{Binding CanRename}">
                                                        <MenuItem Header="RENAME"
                                                                  Command="{Binding RenameCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>

                                                <Grid ColumnDefinitions="Auto,18,Auto,*">
                                                    <Border Width="{Binding IndentWidth}" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="›"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                                    <CheckBox Grid.Column="2"
                                                              IsVisible="{Binding IsCopySelectionMode}"
                                                              IsEnabled="{Binding IsCopySelectable}"
                                                              IsChecked="{Binding IsCopySelected, Mode=OneWay}"
                                                              IsHitTestVisible="False"
                                                              Margin="0,0,7,0"
                                                              VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Name}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Tags -->
                        <Grid Grid.Row="1"
                              RowDefinitions="Auto,*"
                              MinHeight="0"
                              ClipToBounds="True">

                            <Border Grid.Row="0"
                                    Padding="18,15"
                                    BorderBrush="{StaticResource CriptyBorderBrush}"
                                    BorderThickness="0,1,0,1">

                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="TAGS"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <Button Grid.Column="1"
                                            Classes="sidebar-action"
                                            Command="{Binding NewTagCommand}"
                                            Margin="0,0,6,0">

                                        <TextBlock Text="NEW"
                                                   LetterSpacing="1" />
                                    </Button>

                                    <Button Grid.Column="2"
                                            Classes="sidebar-action danger"
                                            Command="{Binding DeleteTagCommand}">

                                        <TextBlock Text="DELETE"
                                                   LetterSpacing="1" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          MinHeight="0"
                                          VerticalAlignment="Stretch"
                                          AllowAutoHide="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Visible">

                                <ItemsControl ItemsSource="{Binding TagItems}"
                                              Margin="10"
                                              HorizontalAlignment="Stretch"
                                              ItemContainerTheme="{StaticResource StretchingItemContainerTheme}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VaultTagListItemViewModel">
                                            <Button Classes="vault-nav"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding SelectCommand}">

                                                <Button.ContextMenu>
                                                    <ContextMenu IsEnabled="{Binding CanRename}">
                                                        <MenuItem Header="RENAME"
                                                                  Command="{Binding RenameCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>

                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="7">

                                                        <TextBlock Text="#"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource CriptyAccentBrush}" />

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding EntryCountText}"
                                                               Margin="8,0,0,0"
                                                               FontSize="8"
                                                               LetterSpacing="0.7"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Entry list -->
                <Grid Grid.Column="1"
                      RowDefinitions="Auto,*"
                      MinHeight="0"
                      IsVisible="{Binding IsEntryBrowserVisible}"
                      ClipToBounds="True">

                    <!-- Entry toolbar -->
                    <Border Grid.Row="0"
                            Padding="24,18"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="0,0,0,1">

                        <Grid RowDefinitions="Auto,Auto">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding CurrentFilterTitle}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />

                                    <TextBlock Text="{Binding CurrentFilterDescription}"
                                               FontSize="9"
                                               LetterSpacing="1.2"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="12,0"
                                        Padding="10,6"
                                        VerticalAlignment="Center"
                                        Background="#0A1C12"
                                        BorderBrush="{StaticResource CriptyBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">

                                    <TextBlock Text="{Binding EntryCountText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </Border>

                                <Button Grid.Column="2"
                                        Classes="selection-action"
                                        Command="{Binding EnterCopySelectionCommand}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="SELECT"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>

                                <Button Grid.Column="3"
                                        Classes="primary"
                                        Command="{Binding NewEntryCommand}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="ADD ENTRY"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>

                                <Button Grid.Column="4"
                                        Classes="info-action"
                                        Command="{Binding OpenEntryCommand}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="OPEN ENTRY"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>

                                <Button Grid.Column="5"
                                        Classes="ghost"
                                        Command="{Binding OpenEntryMoveCommand}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="MOVE ENTRY"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>

                                <Button Grid.Column="6"
                                        Classes="danger"
                                        Command="{Binding DeleteEntryCommand}"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{Binding DeleteEntryActionText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,14,0,0"
                                  ColumnDefinitions="*,220">

                                <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="200"
                                         Watermark="Search entries by name" />

                                <ComboBox Grid.Column="1"
                                          Classes="entry-sort"
                                          Margin="10,0,0,0"
                                          ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch">

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VaultEntrySortOptionViewModel">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.8" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Scrollable entries -->
                    <Grid Grid.Row="1"
                          RowDefinitions="*,Auto"
                          ColumnDefinitions="*,220"
                          MinHeight="0"
                          ClipToBounds="True">

                        <ScrollViewer Grid.Column="0"
                                      MinHeight="0"
                                      VerticalAlignment="Stretch"
                                      AllowAutoHide="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible"
                                      IsVisible="{Binding HasEntries}">

                            <ItemsControl ItemsSource="{Binding EntryItems}"
                                          Margin="24"
                                          HorizontalAlignment="Stretch"
                                          ItemContainerTheme="{StaticResource StretchingItemContainerTheme}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VaultEntryListItemViewModel">
                                        <Button Classes="entry-row"
                                                Classes.selected="{Binding IsSelected}"
                                                Classes.copy-selected="{Binding IsCopySelected}"
                                                Classes.new-entry="{Binding IsNewEntry}"
                                                Classes.modified-entry="{Binding IsModifiedEntry}"
                                                Classes.pending-deletion="{Binding IsPendingDeletion}"
                                                HorizontalAlignment="Stretch"
                                                DoubleTapped="OpenEntryOnDoubleTapped"
                                                Command="{Binding SelectCommand}">

                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <CheckBox IsVisible="{Binding IsCopySelectionMode}"
                                                          IsEnabled="{Binding IsCopySelectable}"
                                                          IsChecked="{Binding IsCopySelected, Mode=OneWay}"
                                                          IsHitTestVisible="False"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1"
                                                            Spacing="5">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Text="{Binding LocationText}"
                                                               FontSize="9"
                                                               LetterSpacing="0.7"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                                    <TextBlock Text="{Binding TagSummary}"
                                                               FontSize="9"
                                                               LetterSpacing="0.7"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Text="MARKED FOR DELETION · SAVE TO APPLY"
                                                               IsVisible="{Binding IsPendingDeletion}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{StaticResource CriptyDangerBrush}" />

                                                    <TextBlock Text="NEW ENTRY · SAVE TO APPLY"
                                                               IsVisible="{Binding IsNewEntry}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{StaticResource CriptyAccentBrush}" />

                                                    <TextBlock Text="MODIFIED ENTRY · SAVE TO APPLY"
                                                               IsVisible="{Binding IsModifiedEntry}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{StaticResource CriptyInfoBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            Spacing="5">

                                                    <TextBlock Text="{Binding RevisionText}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="9"
                                                               LetterSpacing="0.7"
                                                               Foreground="{StaticResource CriptyAccentBrush}" />

                                                    <TextBlock Text="{Binding CreatedText}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="9"
                                                               LetterSpacing="0.7"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                                    <TextBlock Text="{Binding ModifiedText}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="9"
                                                               LetterSpacing="0.7"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.ColumnSpan="2"
                                    IsVisible="{Binding HasNoEntries}"
                                    Width="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">

                            <TextBlock Text="NO ENTRIES MATCH THIS VIEW"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.2" />

                            <TextBlock Text="Choose another folder or tag, adjust the search, or add a new entry."
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                IsVisible="{Binding IsCopySelectionMode}"
                                Padding="18,12"
                                Background="#0A1C12"
                                BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                                BorderThickness="0,1,0,0">

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <TextBlock Text="{Binding CopySelectionSummaryText}"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           Foreground="{StaticResource CriptyAccentBrush}" />

                                <Button Grid.Column="1"
                                        Classes="ghost"
                                        Command="{Binding SelectAllVisibleForCopyCommand}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="SELECT VISIBLE"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8" />
                                </Button>

                                <Button Grid.Column="2"
                                        Classes="ghost"
                                        Command="{Binding ClearCopySelectionCommand}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="CLEAR"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8" />
                                </Button>

                                <Button Grid.Column="3"
                                        Classes="ghost"
                                        Command="{Binding CancelCopySelectionCommand}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="CANCEL"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8" />
                                </Button>

                                <Button Grid.Column="4"
                                        Classes="primary"
                                        Command="{Binding OpenCopyDialogCommand}">
                                    <TextBlock Text="COPY TO VAULT"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ContentControl Grid.Column="1"
                                Content="{Binding EntryEditor}"
                                IsVisible="{Binding HasOpenEntry}"
                                IsEnabled="{Binding !IsBusy}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>

        <!-- More options panel -->
        <Border Grid.RowSpan="2"
                ZIndex="80"
                IsVisible="{Binding IsMoreOptionsOpen}"
                Background="#D907110D">

            <Border Width="500"
                    Margin="32"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="VAULT OPTIONS"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />

                            <TextBlock Text="Security, session, and vault-level actions."
                                       FontSize="11"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CloseMoreOptionsCommand}">

                            <TextBlock Text="CLOSE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>

                    <Border Padding="14"
                            Background="#0A1C12"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <StackPanel Spacing="8">
                            <TextBlock Text="VAULT DIRECTORY"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.2"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />

                            <TextBlock Text="{Binding VaultDirectoryPath}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="VAULT ID"
                                       Margin="0,6,0,0"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.2"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />

                            <TextBlock Text="{Binding VaultIdText}"
                                       FontSize="10" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="14">
                                <TextBlock Text="{Binding ManifestSchemaText}"
                                           FontSize="9"
                                           LetterSpacing="0.8"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="{Binding ManifestGenerationText}"
                                           FontSize="9"
                                           LetterSpacing="0.8"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="6">
                        <Button Classes="primary"
                                Command="{Binding OpenPasswordChangeCommand}"
                                HorizontalContentAlignment="Center">

                            <TextBlock Text="CHANGE PASSWORD"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <TextBlock Text="{Binding PasswordChangeAvailabilityText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="9"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Password change dialog -->
        <Border Grid.RowSpan="2"
                ZIndex="90"
                IsVisible="{Binding IsPasswordChangeOpen}"
                Background="#E607110D">

            <Border Width="540"
                    Margin="32"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CHANGE VAULT PASSWORD"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="Choose a new password and the Argon2id parameters that will protect this vault. A fresh root key is generated and every entry and blob is re-encrypted before the rotated vault replaces the current one. Temporary free space roughly equal to the vault size is required."
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="NEW PASSWORD"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.3"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CaretIndex="{Binding NewPasswordCaretIndex, Mode=TwoWay}"
                                     IsEnabled="{Binding !IsBusy}"
                                     PasswordChar="{Binding NewPasswordMaskCharacter}" />

                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Focusable="False"
                                    Margin="8,0,0,0"
                                    MinWidth="42"
                                    IsEnabled="{Binding !IsBusy}"
                                    Content="Ă"
                                    ToolTip.Tip="Insert an extended Latin letter at the caret">

                                <Button.Flyout>
                                    <Flyout>
                                        <views:ExtendedLatinCharacterPickerView
                                            CharacterSelected="InsertNewPasswordSpecialCharacter" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Focusable="False"
                                    Margin="8,0,0,0"
                                    MinWidth="70"
                                    Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                    Content="{Binding NewPasswordVisibilityActionText}" />
                        </Grid>

                        <TextBlock Text="{Binding NewPasswordCharacterCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="8"
                                   LetterSpacing="0.7"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock Text="CONFIRM NEW PASSWORD"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.3"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Text="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CaretIndex="{Binding ConfirmNewPasswordCaretIndex, Mode=TwoWay}"
                                     IsEnabled="{Binding !IsBusy}"
                                     PasswordChar="{Binding ConfirmNewPasswordMaskCharacter}" />

                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Focusable="False"
                                    Margin="8,0,0,0"
                                    MinWidth="42"
                                    IsEnabled="{Binding !IsBusy}"
                                    Content="Ă"
                                    ToolTip.Tip="Insert an extended Latin letter at the caret">

                                <Button.Flyout>
                                    <Flyout>
                                        <views:ExtendedLatinCharacterPickerView
                                            CharacterSelected="InsertConfirmNewPasswordSpecialCharacter" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Focusable="False"
                                    Margin="8,0,0,0"
                                    MinWidth="70"
                                    Command="{Binding ToggleConfirmNewPasswordVisibilityCommand}"
                                    Content="{Binding ConfirmNewPasswordVisibilityActionText}" />
                        </Grid>

                        <TextBlock Text="{Binding ConfirmNewPasswordCharacterCountText}"
                                   HorizontalAlignment="Right"
                                   FontSize="8"
                                   LetterSpacing="0.7"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />
                    </StackPanel>

                    <Border Padding="12"
                            Background="#0A1C12"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="KEY DERIVATION"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.3"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="{Binding PasswordKdfSummaryText}"
                                           FontSize="11"
                                           Foreground="{StaticResource CriptyTextBrush}" />

                                <TextBlock Text="{Binding PasswordKdfProfileText}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.9"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Command="{Binding OpenPasswordKdfSettingsCommand}"
                                    Margin="12,0,0,0"
                                    Padding="11,7"
                                    VerticalAlignment="Center">

                                <TextBlock Text="KDF SETTINGS"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.9" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Padding="12"
                            Background="#0A1C12"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid>
                            <TextBlock IsVisible="{Binding !IsChangingPassword}"
                                       Text="A new root key will replace the current one. Every entry and blob is re-encrypted, while the vault ID, folders, tags, and entry organization are preserved."
                                       FontSize="9"
                                       LineHeight="14"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextWrapping="Wrap" />

                            <StackPanel IsVisible="{Binding IsChangingPassword}"
                                        Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding PasswordChangeProgressStatusText}"
                                               FontSize="9"
                                               LineHeight="14"
                                               Foreground="{StaticResource CriptyTextBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Text="{Binding PasswordChangeProgressPercentageText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource CriptyAccentBrush}" />
                                </Grid>

                                <ProgressBar Height="5"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding PasswordChangeProgressPercentage}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasPasswordChangeError}"
                            Padding="11"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="{Binding PasswordChangeErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelPasswordChangeCommand}"
                                Margin="0,0,8,0">

                            <TextBlock Text="CANCEL"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary"
                                Command="{Binding ConfirmPasswordChangeCommand}">

                            <TextBlock Text="{Binding PasswordChangeActionText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Password KDF settings dialog -->
        <Border Grid.RowSpan="2"
                ZIndex="100"
                IsVisible="{Binding IsPasswordKdfSettingsOpen}"
                Background="#E607110D">

            <Border Width="620"
                    MaxHeight="650"
                    Margin="32"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Spacing="22">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="ARGON2ID SETTINGS"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />

                                <TextBlock Text="Parameters used to derive the wrapping key from the new password."
                                           FontSize="12"
                                           Foreground="{StaticResource CriptyTextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    VerticalAlignment="Top"
                                    Background="#0A1C12"
                                    BorderBrush="#1B3828"
                                    BorderThickness="1"
                                    CornerRadius="3">

                                <TextBlock Text="VERSION 1.3"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Border>
                        </Grid>

                        <Border Padding="13"
                                Background="#291B13"
                                BorderBrush="#6B4632"
                                BorderThickness="1"
                                CornerRadius="3">

                            <TextBlock Text="Higher values consume more memory or CPU time during this password change and every future vault unlock."
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{StaticResource CriptyDangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="MEMORY"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <TextBlock Text="Memory allocated while deriving the wrapping key."
                                               FontSize="11"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PasswordKdfMemoryValueText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Grid>

                            <Slider Minimum="{Binding MinimumPasswordKdfMemorySizeMiB}"
                                    Maximum="{Binding MaximumPasswordKdfMemorySizeMiB}"
                                    Value="{Binding PasswordKdfDraftMemorySizeMiB, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding MinimumPasswordKdfMemorySizeText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaximumPasswordKdfMemorySizeText}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="ITERATIONS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <TextBlock Text="Repeated passes over the configured memory."
                                               FontSize="11"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PasswordKdfIterationsValueText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Grid>

                            <Slider Minimum="{Binding MinimumPasswordKdfIterations}"
                                    Maximum="{Binding MaximumPasswordKdfIterations}"
                                    Value="{Binding PasswordKdfDraftIterations, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding MinimumPasswordKdfIterations}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaximumPasswordKdfIterations}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="PARALLELISM"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.5"
                                               Foreground="{StaticResource CriptyTextMutedBrush}" />

                                    <TextBlock Text="CPU lanes used for performance tuning; it is not a direct strength setting."
                                               FontSize="11"
                                               Foreground="{StaticResource CriptyTextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding PasswordKdfParallelismValueText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CriptyAccentBrush}" />
                            </Grid>

                            <Slider Minimum="{Binding MinimumPasswordKdfParallelism}"
                                    Maximum="{Binding MaximumPasswordKdfParallelism}"
                                    Value="{Binding PasswordKdfDraftParallelism, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding MinimumPasswordKdfParallelism}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding MaximumPasswordKdfParallelism}"
                                           FontSize="9"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Classes="ghost"
                                    Command="{Binding RestoreDefaultPasswordKdfSettingsCommand}">

                                <TextBlock Text="RESTORE DEFAULTS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="ghost"
                                    Command="{Binding CancelPasswordKdfSettingsCommand}"
                                    Margin="0,0,8,0">

                                <TextBlock Text="CANCEL"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="primary"
                                    Command="{Binding ApplyPasswordKdfSettingsCommand}">

                                <TextBlock Text="APPLY"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- Cross-vault copy destination dialog -->
        <Border Grid.RowSpan="2"
                ZIndex="105"
                IsVisible="{Binding IsCopyDialogOpen}"
                Background="#E607110D">

            <Border Width="680"
                    Margin="18"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="COPY TO ANOTHER VAULT"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />

                            <TextBlock Text="Choose an existing destination vault. Entries, images, tags, and required folder paths are copied; the source vault is never changed."
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelCopyDialogCommand}"
                                Margin="14,0,0,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="CLOSE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>

                    <Border Padding="12"
                            Background="#0A1C12"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding CopySelectionSummaryText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   LetterSpacing="0.9"
                                   Foreground="{StaticResource CriptyAccentBrush}" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="DESTINATION VAULT"
                                   VerticalAlignment="Center"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.3"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <Button Grid.Column="1"
                                Classes="ghost"
                                Click="ChooseCopyTargetVault_Click">
                            <TextBlock Text="BROWSE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>

                    <Border Height="190"
                            Background="#09150F"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid>
                            <ScrollViewer AllowAutoHide="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Visible">
                                <ItemsControl ItemsSource="{Binding CopyTargetVaults}"
                                              Margin="8"
                                              ItemContainerTheme="{StaticResource StretchingItemContainerTheme}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VaultCopyTargetItemViewModel">
                                            <Button Classes="vault-nav"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding SelectCommand}">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DirectoryPath}"
                                                               FontSize="8"
                                                               Foreground="{StaticResource CriptyTextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="SCANNING FOR VAULTS..."
                                       IsVisible="{Binding IsDiscoveringCopyTargets}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       LetterSpacing="1"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />

                            <TextBlock Text="NO OTHER VAULTS FOUND · USE BROWSE"
                                       IsVisible="{Binding HasNoCopyTargets}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       LetterSpacing="0.8"
                                       Foreground="{StaticResource CriptyTextMutedBrush}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding SelectedCopyTargetText}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               LetterSpacing="0.8"
                               Foreground="{StaticResource CriptyAccentBrush}" />

                    <StackPanel Spacing="7">
                        <TextBlock Text="DESTINATION PASSWORD"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.3"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding CopyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CaretIndex="{Binding CopyPasswordCaretIndex, Mode=TwoWay}"
                                     PasswordChar="{Binding CopyPasswordMaskCharacter}"
                                     IsEnabled="{Binding !IsCopying}" />

                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Command="{Binding ToggleCopyPasswordVisibilityCommand}"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding CopyPasswordVisibilityActionText}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.8" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border IsVisible="{Binding HasCopyDialogError}"
                            Padding="11"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock Text="{Binding CopyDialogErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelCopyDialogCommand}"
                                Margin="0,0,8,0">
                            <TextBlock Text="CANCEL"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary"
                                Command="{Binding ConfirmCopyCommand}">
                            <TextBlock Text="{Binding CopyActionText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Entry/folder move destination dialog -->
        <Border Grid.RowSpan="2"
                ZIndex="100"
                IsVisible="{Binding IsMoveDialogOpen}"
                Background="#E607110D">

            <Border Width="640"
                    Margin="18"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding MoveDialogTitle}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />

                            <TextBlock Text="{Binding MoveDialogDescription}"
                                       FontSize="11"
                                       LineHeight="17"
                                       Foreground="{StaticResource CriptyTextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelMoveDialogCommand}"
                                Margin="14,0,0,0"
                                VerticalAlignment="Top">

                            <TextBlock Text="CLOSE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>

                    <Border Padding="13"
                            Background="#0A1C12"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="4">
                                <TextBlock Text="MOVING"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.2"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="{Binding MoveItemName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="4">
                                <TextBlock Text="CURRENT LOCATION"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.2"
                                           Foreground="{StaticResource CriptyTextMutedBrush}" />

                                <TextBlock Text="{Binding MoveCurrentLocationText}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding MoveCurrentLocationText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="7">
                        <TextBlock Text="DESTINATION FOLDER"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.3"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <Border Height="210"
                                Background="#09150F"
                                BorderBrush="{StaticResource CriptyBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">

                            <ScrollViewer AllowAutoHide="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Visible">

                                <ItemsControl ItemsSource="{Binding MoveDestinationItems}"
                                              Margin="8"
                                              HorizontalAlignment="Stretch"
                                              ItemContainerTheme="{StaticResource StretchingItemContainerTheme}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VaultMoveDestinationItemViewModel">
                                            <Grid>
                                                <Button Classes="vault-nav"
                                                        Classes.selected="{Binding IsSelected}"
                                                        IsEnabled="{Binding IsSelectable}"
                                                        Command="{Binding SelectCommand}"
                                                        ToolTip.Tip="{Binding PathText}">

                                                    <Grid ColumnDefinitions="Auto,18,*">
                                                        <Border Width="{Binding IndentWidth}" />

                                                        <StackPanel Grid.Column="2"
                                                                    Spacing="2">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Text="{Binding DisabledReason}"
                                                                       IsVisible="{Binding HasDisabledReason}"
                                                                       FontSize="8"
                                                                       Foreground="{StaticResource CriptyDangerBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Grid ColumnDefinitions="Auto,18,*">
                                                    <Border Width="{Binding IndentWidth}" />

                                                    <Button Grid.Column="1"
                                                            Classes="folder-toggle"
                                                            IsVisible="{Binding IsExpandable}"
                                                            Command="{Binding ToggleExpansionCommand}"
                                                            ToolTip.Tip="Expand or collapse folder">

                                                        <TextBlock Text="{Binding ExpansionGlyph}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource CriptyAccentBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <Border Padding="11"
                            Background="#0A1C12"
                            BorderBrush="{StaticResource CriptyBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="{Binding MoveDestinationText}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="0.8"
                                   Foreground="{StaticResource CriptyAccentBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Border IsVisible="{Binding HasMoveDialogError}"
                            Padding="11"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="{Binding MoveDialogErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelMoveDialogCommand}"
                                Margin="0,0,8,0">

                            <TextBlock Text="CANCEL"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary"
                                Command="{Binding ConfirmMoveDialogCommand}">

                            <TextBlock Text="{Binding MoveDialogActionText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Create/rename/delete/lock dialog -->
        <Border Grid.RowSpan="2"
                ZIndex="100"
                IsVisible="{Binding IsDialogOpen}"
                Background="#E607110D">

            <Border Width="500"
                    Margin="32"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource CriptySurfaceBrush}"
                    BorderBrush="{StaticResource CriptyBorderBrightBrush}"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />

                        <TextBlock Text="{Binding DialogDescription}"
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{StaticResource CriptyTextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsDialogInputVisible}"
                                Spacing="7">

                        <TextBlock Text="NAME"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1.3"
                                   Foreground="{StaticResource CriptyTextMutedBrush}" />

                        <TextBox Text="{Binding DialogInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200"
                                 Watermark="Enter a name" />
                    </StackPanel>

                    <Border IsVisible="{Binding HasDialogError}"
                            Padding="11"
                            Background="#291B13"
                            BorderBrush="{StaticResource CriptyDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="3">

                        <TextBlock Text="{Binding DialogErrorMessage}"
                                   Foreground="{StaticResource CriptyDangerBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Command="{Binding CancelDialogCommand}"
                                Margin="0,0,8,0">

                            <TextBlock Text="CANCEL"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="primary"
                                IsVisible="{Binding IsDialogInputVisible}"
                                Command="{Binding ConfirmDialogCommand}">

                            <TextBlock Text="{Binding DialogPrimaryActionText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>

                        <Button Grid.Column="2"
                                Classes="danger"
                                IsVisible="{Binding IsDialogDestructive}"
                                Command="{Binding ConfirmDialogCommand}">

                            <TextBlock Text="{Binding DialogPrimaryActionText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
